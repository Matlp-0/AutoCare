<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Carbon.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/fuel_add" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/carbon_gutter"
            android:paddingEnd="@dimen/carbon_gutter"
            android:paddingBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDate"
                style="@style/Carbon.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/field_date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutKm"
                style="@style/Carbon.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_km"
                app:suffixText="km">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputKm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFuelType"
                style="@style/Carbon.Input.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_fuel_type">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/inputFuelType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutLiters"
                style="@style/Carbon.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_liters"
                app:suffixText="L">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputLiters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPrice"
                style="@style/Carbon.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_price_per_liter"
                app:prefixText="R$">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutTotal"
                style="@style/Carbon.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_total_paid"
                app:prefixText="R$">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_xs"
                android:text="@string/fuel_total_hint" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutStation"
                style="@style/Carbon.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_station">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputStation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkFullTank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_md"
                android:checked="true"
                android:minHeight="@dimen/carbon_touch_min"
                android:text="@string/fuel_full_tank"
                android:textColor="@color/carbon_text_primary" />

            <TextView
                style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fuel_full_tank_hint" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkMissedPrevious"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_sm"
                android:minHeight="@dimen/carbon_touch_min"
                android:text="@string/fuel_missed_previous"
                android:textColor="@color/carbon_text_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNotes"
                style="@style/Carbon.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_notes">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/buttonSave"
                style="@style/Carbon.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_lg"
                android:gravity="center"
                android:text="@string/action_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
