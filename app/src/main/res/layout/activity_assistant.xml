<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/carbon_bg" android:fitsSystemWindows="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" style="@style/Carbon.Toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/ai_title" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/carbon_gutter">
            <TextView android:id="@+id/textAiVehicle" style="@style/Carbon.Text.Value"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView style="@style/Carbon.Text.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/ai_description" />
            <TextView style="@style/Carbon.Text.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/ai_model_description" />
            <Button android:id="@+id/buttonAiDownload" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/ai_download" />
            <Button android:id="@+id/buttonAiImport" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/ai_import" />
            <Button android:id="@+id/buttonAiSource" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/ai_source" />
            <Button android:id="@+id/buttonAiDelete" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/ai_delete" />
            <TextView android:id="@+id/textAiStatus" style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/progressAi" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:indeterminate="true" android:visibility="gone" />
            <com.example.myapplication.ui.carbon.CarbonSectionTitle
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/ai_ask_section" />
            <Button android:id="@+id/buttonAiSchedule" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/ai_schedule" />
            <Button android:id="@+id/buttonAiHistory" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/ai_history" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Carbon.Input" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:hint="@string/ai_question_hint" app:counterEnabled="true" app:counterMaxLength="500">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editAiQuestion" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="500" android:minLines="2" android:maxLines="5" />
            </com.google.android.material.textfield.TextInputLayout>
            <Button android:id="@+id/buttonAiAsk" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/ai_ask" />
            <Button android:id="@+id/buttonAiCancel" style="@style/Carbon.Button"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/ai_cancel" android:visibility="gone" />
            <TextView android:id="@+id/textAiAnswer" style="@style/Carbon.Text.Body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:textIsSelectable="true" />
            <TextView style="@style/Carbon.Text.Caption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/ai_note" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
