<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_bg"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/carbon_bg"
        android:fitsSystemWindows="true">

    <!--
      Faixa superior: identidade do veículo em foco. Com vários carros na
      garagem, saber "qual carro estou vendo" é pré-requisito de qualquer aba.
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@color/carbon_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/carbon_space_sm"
        android:paddingEnd="@dimen/carbon_gutter">

        <ImageView
            android:id="@+id/buttonMenu"
            android:layout_width="@dimen/carbon_touch_min"
            android:layout_height="@dimen/carbon_touch_min"
            android:background="@drawable/carbon_detail_press"
            android:contentDescription="@string/garage_open"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            app:tint="@color/carbon_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/carbon_space_xs">

            <TextView
                android:id="@+id/textActiveVehicle"
                style="@style/Carbon.Text.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/textActiveVehicleKm"
                style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="80dp" />

    <!--
      Carbon UI: mesmo FloatingActionButton (a lógica do MainActivity não muda),
      mas com forma quase reta, sem elevação e nas cores do HUD.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/carbon_gutter"
        android:layout_marginBottom="96dp"
        android:contentDescription="@string/add_title"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/carbon_surface_raised"
        app:borderWidth="0dp"
        app:elevation="0dp"
        app:hoveredFocusedTranslationZ="0dp"
        app:pressedTranslationZ="0dp"
        app:rippleColor="@color/carbon_cyan_dim"
        app:shapeAppearanceOverlay="@style/Carbon.Fab.Shape"
        app:tint="@color/carbon_accent" />

    <!--
      Carbon UI: mesma BottomNavigationView, mesmos destinos e mesma lógica.
      Só a pele mudou — sem pill, indicador linear inferior em amarelo ácido.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/carbon_nav_background"
        android:minHeight="@dimen/carbon_nav_height"
        app:activeIndicatorLabelPadding="0dp"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Carbon.Nav.ActiveIndicator"
        app:itemBackground="@drawable/carbon_nav_item_background"
        app:itemIconTint="@color/carbon_nav_item"
        app:itemPaddingTop="10dp"
        app:itemRippleColor="@color/carbon_cyan_dim"
        app:itemTextAppearanceActive="@style/Carbon.Nav.Label.Active"
        app:itemTextAppearanceInactive="@style/Carbon.Nav.Label"
        app:itemTextColor="@color/carbon_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/drawerVehicles"
        layout="@layout/view_vehicle_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</androidx.drawerlayout.widget.DrawerLayout>
