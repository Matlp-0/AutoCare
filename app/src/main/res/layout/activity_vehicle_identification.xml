<?xml version="1.0" encoding="utf-8"?>
<!-- Identificação do veículo no Carbon UI. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/carbon_gutter"
        android:paddingTop="@dimen/carbon_space_lg"
        android:paddingEnd="@dimen/carbon_gutter"
        android:paddingBottom="@dimen/carbon_space_lg">

        <com.example.myapplication.ui.carbon.CarbonSectionTitle
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/identification_title" />

        <TextView
            android:id="@+id/textVehicle"
            style="@style/Carbon.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_space_md"
            android:textSize="24sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/carbon_rule"
            android:layout_marginTop="@dimen/carbon_space_sm"
            android:background="@color/carbon_cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Carbon.Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/identification_plan" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/carbon_cyan"
                app:indicatorSize="20dp"
                app:trackThickness="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            style="@style/Carbon.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_space_xs"
            android:text="@string/identification_searching" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPlan"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/carbon_space_sm"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/textSource"
            style="@style/Carbon.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/buttonSearchOnline"
            style="@style/Carbon.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="@dimen/carbon_touch_min"
            android:background="@drawable/carbon_detail_press"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/identification_search_online"
            android:textColor="@color/carbon_accent" />

        <TextView
            android:id="@+id/buttonConfirm"
            style="@style/Carbon.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_space_sm"
            android:text="@string/identification_confirm" />
    </LinearLayout>
</LinearLayout>
