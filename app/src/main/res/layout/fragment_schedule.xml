<?xml version="1.0" encoding="utf-8"?>
<!-- Revisões no Carbon UI: log técnico do veículo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/carbon_gutter"
    android:paddingTop="@dimen/carbon_space_lg"
    android:paddingEnd="@dimen/carbon_gutter">

    <com.example.myapplication.ui.carbon.CarbonSectionTitle
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/schedule_title" />

    <TextView
        style="@style/Carbon.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_space_xs"
        android:text="@string/carbon_subtitle_schedule" />

    <TextView
        android:id="@+id/textVehicleKm"
        style="@style/Carbon.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_space_sm"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/carbon_text_primary" />

    <com.example.myapplication.ui.carbon.CarbonDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_space_sm" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTimeline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:scrollbars="none" />

    <LinearLayout
        android:id="@+id/groupEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingBottom="96dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textEmpty"
            style="@style/Carbon.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_empty" />

        <TextView
            android:id="@+id/buttonFindPlan"
            style="@style/Carbon.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_space_md"
            android:text="@string/carbon_action_find_plan" />
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
