<?xml version="1.0" encoding="utf-8"?>
<!--
  Barra lateral do Carbon UI: garagem do usuário. Trocar o veículo aqui troca a
  fonte de todas as abas (painel, cronograma, manutenções, combustível).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_surface_raised"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/carbon_gutter"
    android:paddingTop="@dimen/carbon_space_lg"
    android:paddingEnd="@dimen/carbon_gutter">

    <com.example.myapplication.ui.carbon.CarbonSectionTitle
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/garage_title" />

    <TextView
        style="@style/Carbon.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_space_xs"
        android:text="@string/garage_subtitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVehicles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/carbon_space_md"
        android:layout_weight="1"
        android:scrollbars="none" />

    <com.example.myapplication.ui.carbon.CarbonDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/buttonAddVehicle"
        style="@style/Carbon.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_space_md"
        android:layout_marginBottom="@dimen/carbon_space_lg"
        android:text="@string/garage_add" />
</LinearLayout>
