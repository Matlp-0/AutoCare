<?xml version="1.0" encoding="utf-8"?>
<!-- Painel financeiro: quanto o carro custa, por km e por mês. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Carbon.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/finance_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/carbon_gutter"
            android:paddingEnd="@dimen/carbon_gutter"
            android:paddingBottom="@dimen/carbon_space_xl">

            <TextView
                android:id="@+id/textVehicle"
                style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/textCostPerKm"
                style="@style/Carbon.Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_sm" />

            <TextView
                android:id="@+id/textCostPerKmCaption"
                style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/finance_cost_per_km_caption" />

            <!-- COMPOSIÇÃO -->
            <com.example.myapplication.ui.carbon.CarbonSectionTitle
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_lg"
                android:text="@string/finance_composition" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/carbon_space_md"
                android:orientation="horizontal">

                <View
                    android:id="@+id/barMaintenance"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/carbon_accent" />

                <View
                    android:id="@+id/barFuel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/carbon_cyan" />
            </LinearLayout>

            <com.example.myapplication.ui.carbon.CarbonTechnicalRow
                android:id="@+id/rowMaintenance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.myapplication.ui.carbon.CarbonTechnicalRow
                android:id="@+id/rowFuel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.myapplication.ui.carbon.CarbonDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.myapplication.ui.carbon.CarbonTechnicalRow
                android:id="@+id/rowTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.myapplication.ui.carbon.CarbonTechnicalRow
                android:id="@+id/rowMonthlyAverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.myapplication.ui.carbon.CarbonTechnicalRow
                android:id="@+id/rowCurrentMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.myapplication.ui.carbon.CarbonTechnicalRow
                android:id="@+id/rowProjection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/textBase"
                style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_xs" />

            <!-- MÊS A MÊS -->
            <com.example.myapplication.ui.carbon.CarbonSectionTitle
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_lg"
                android:text="@string/finance_monthly" />

            <com.example.myapplication.ui.finance.MonthlyBarChart
                android:id="@+id/chartMonthly"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="@dimen/carbon_space_md" />

            <TextView
                android:id="@+id/textMonthlyPeak"
                style="@style/Carbon.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ONDE O DINHEIRO FOI -->
            <com.example.myapplication.ui.carbon.CarbonSectionTitle
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_lg"
                android:text="@string/finance_categories" />

            <LinearLayout
                android:id="@+id/groupCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_sm"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textEmpty"
                style="@style/Carbon.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_space_md"
                android:text="@string/finance_empty"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
