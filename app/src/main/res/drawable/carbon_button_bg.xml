<?xml version="1.0" encoding="utf-8"?>
<!-- Controle Carbon: geometria reta com canto cortado, sem pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/carbon_cyan_dim">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/carbon_surface_raised" />
                    <stroke android:width="1dp" android:color="@color/carbon_line_strong" />
                </shape>
            </item>
            <item android:width="@dimen/carbon_rule" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/carbon_cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
